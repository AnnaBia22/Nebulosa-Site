---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const noticias = [
  {
    id: 1,
    titulo: "titulo",
    subtitulo: "Subtitulo",
    data: "data",
    tema: "tema",
    imagem: "/logo-nebulosa.png"
  },
  {
    id: 2,
    titulo: "titulo",
    subtitulo: "Subtitulo",
    data: "data",
    tema: "tema",
    imagem: "/logo-nebulosa.png"
  },
  {
    id: 3,
    titulo: "titulo",
    subtitulo: "Subtitulo",
    data: "data",
    tema: "tema",
    imagem: "/logo-nebulosa.png"
  }
];
---

<Layout title="Nebulosa | Notícias">
  <Header />

  <main class="w-full max-w-5xl mx-auto px-6 py-10 text-[#2F0147] font-acme">
    
    <!-- Título da Página -->
    <h1 class="font-magic text-5xl md:text-6xl text-center py-10 text-[#F3A446] mb-12 tracking-wide">
      Noticias
    </h1>

    <!-- Lista de Banners de Notícias -->
    <div class="flex flex-col gap-6 w-full">
      {noticias.map((item) => (
        <article class="bg-[#EFE3E8] p-6 rounded-3xl flex flex-row items-center gap-8 shadow-sm">
          
          <!-- Caixinha Escura Fixa da Imagem -->
          <div 
            class="bg-[#0B032D] rounded-2xl flex items-center justify-center p-3 overflow-hidden shrink-0"
            style="width: 240px; height: 140px; min-width: 240px;"
          >
            <img 
              src={item.imagem} 
              alt={item.titulo} 
              style="max-width: 100%; max-height: 100%; object-fit: contain;"
            />
          </div>

          <!-- Informações da Notícia à direita -->
          <div class="flex flex-col justify-center text-left space-y-1">
            <h2 class="text-3xl font-bold text-[#2F0147] leading-tight">
              {item.titulo}
            </h2>
            
            <p class="text-lg text-[#2F0147] font-bold">
              {item.subtitulo}
            </p>
            
            <p class="text-sm text-[#2F0147] font-bold">
              {item.data} - {item.tema}
            </p>
          </div>

        </article>
      ))}
    </div>

  </main>

  <Footer />
</Layout>