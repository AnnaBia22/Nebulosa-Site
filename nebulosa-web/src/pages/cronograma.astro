---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// Dados da tabela de cronograma
const eventos = [
  {
    datas: "10/03 - 15/03",
    feira: "Feira de Ciências & Tecnologia",
    premios: "Credenciamento + Medalhas de Ouro/Prata",
    dados: "Inscrições abertas até 01/03. Etapa presencial."
  },
  {
    datas: "22/04 - 25/04",
    feira: "Olimpíada Brasileira de Informática (OBI)",
    premios: "Certificado Nacional + Bolsas",
    dados: "Prova online na primeira fase. Gratuito."
  },
  {
    datas: "12/05 - 18/05",
    feira: "Mostra Internacional de Ciência",
    premios: "Troféus e Apoio Financeiro",
    dados: "Submissão de artigos para avaliação."
  },
  {
    datas: "05/06 - 10/06",
    feira: "Hackathon Nebulosa 2026",
    premios: "Prêmio em dinheiro + Mentoria",
    dados: "Equipes de 2 a 4 pessoas. Foco em tecnologia."
  }
];
---

<Layout title="Nebulosa | Cronograma">
  <Header />

  <main class="w-full max-w-6xl mx-auto px-6 py-10 text-[#2F0147] font-acme">
    
    <!-- Título da Página -->
    <h1 class="font-magic text-5xl md:text-6xl text-center text-[#F3A446] mb-8 tracking-wide">
      Cronograma
    </h1>

    <!-- Texto Explicativo Institucional -->
    <p class="text-justify text-sm leading-relaxed font-normal max-w-4xl mx-auto text-gray-800 mb-12">
      Texto de introdução dos cronogramas. Lorem ipsum dolor sit amet, consectetur adipiscing elit. Nullam in quam nunc. Donec magna arcu, lacinia non commodo in, condimentum eget risus. Phasellus velit odio, lobortis sed viverra in, placerat sit amet magna. Aenean eget rutrum tortor.
    </p>

    <!-- Tabela Estilizada -->
    <div class="w-full overflow-x-auto rounded-2xl shadow-xl border border-[#2F0147]/20 bg-[#FDF8F2]">
      <table class="w-full text-left border-collapse">
        
        <!-- Cabeçalho -->
        <thead>
          <tr class="bg-[#2F0147] text-[#F3A446] text-lg font-bold tracking-wider">
            <th class="py-4 px-6 border-b border-[#610F7F]/40 w-1/5">Datas</th>
            <th class="py-4 px-6 border-b border-[#610F7F]/40 w-1/4">Nome da Feira</th>
            <th class="py-4 px-6 border-b border-[#610F7F]/40 w-1/4">Prêmios?</th>
            <th class="py-4 px-6 border-b border-[#610F7F]/40 w-3/12">Dados</th>
          </tr>
        </thead>

        <!-- Corpo da Tabela -->
        <tbody class="text-sm font-sans font-medium text-[#2F0147]">
          {eventos.map((item, index) => (
            <tr 
              class={`transition-colors duration-200 border-b border-[#2F0147]/10 hover:bg-[#EFE3E8]/80 ${
                index % 2 === 0 ? 'bg-[#FDF8F2]' : 'bg-[#F7EEF2]'
              }`}
            >
              <td class="py-4 px-6 font-semibold text-[#610F7F] whitespace-nowrap">
                {item.datas}
              </td>
              <td class="py-4 px-6 font-bold text-[#2F0147]">
                {item.feira}
              </td>
              <td class="py-4 px-6 text-gray-800">
                {item.premios}
              </td>
              <td class="py-4 px-6 text-gray-700">
                {item.dados}
              </td>
            </tr>
          ))}
        </tbody>

      </table>
    </div>

  </main>

  <Footer />
</Layout>