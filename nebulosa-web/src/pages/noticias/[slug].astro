---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<Layout title="Nebulosa | Notícia">
  <div class="min-h-screen flex flex-col bg-[#FDF8F2]">
    <Header />

    <main class="w-full max-w-4xl mx-auto px-6 py-10 text-[#2F0147] flex-1">
      
      <!-- Estado de Carregamento -->
      <div id="loading-state" class="w-full max-w-xl mx-auto my-12 p-6 rounded-2xl bg-[#EFE3E8] border border-[#2F0147]/20 text-center shadow-sm">
        <p class="text-lg font-bold text-[#2F0147] mb-1">
          Carregando notícia...
        </p>
        <p class="text-xs text-gray-700 font-sans">
          Aguarde um instante enquanto buscamos as informações atualizadas.
        </p>
      </div>

      <!-- Estado de Erro / Não Encontrada -->
      <div id="error-state" class="hidden w-full max-w-xl mx-auto my-12 p-6 rounded-2xl bg-[#EFE3E8] border border-[#2F0147]/20 text-center shadow-sm">
        <p class="text-lg font-bold text-[#2F0147] mb-1">
          Notícia não encontrada.
        </p>
        <p class="text-xs text-gray-700 font-sans">
          Verifique o endereço digitado ou volte para a lista de notícias.
        </p>
      </div>

      <!-- Conteúdo da Notícia -->
      <div id="article-content" class="hidden">
        <header class="mb-8">
          <h1 id="noticia-titulo" class="font-magic text-4xl md:text-5xl text-[#2F0147] mb-3 leading-tight">
          </h1>

          <p id="noticia-subtitulo" class="hidden text-lg md:text-xl font-bold text-gray-800 mb-4 font-sans">
          </p>

          <div class="flex flex-wrap items-center justify-between text-xs text-gray-600 border-b border-[#2F0147]/10 pb-4 font-sans gap-4">
            <div>
              <p id="noticia-autora" class="font-semibold text-gray-700"></p>
              <p id="noticia-data-hora"></p>
            </div>

            <div class="flex items-center gap-3 text-gray-700 shrink-0">
              <button 
                id="share-btn"
                title="Compartilhar" 
                class="hover:text-[#610F7F] transition-colors p-1 flex items-center justify-center shrink-0"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 0 0-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 0 0-5.368-2.684z" />
                </svg>
              </button>

              <a 
                href="https://instagram.com" 
                target="_blank" 
                rel="noopener noreferrer" 
                class="hover:text-[#610F7F] transition-colors p-1 flex items-center justify-center shrink-0" 
                title="Instagram"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 shrink-0" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                </svg>
              </a>

              <a 
                id="wsp-btn"
                href="#" 
                target="_blank" 
                rel="noopener noreferrer" 
                class="hover:text-[#610F7F] transition-colors p-1 flex items-center justify-center shrink-0" 
                title="WhatsApp"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 shrink-0" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.301-.15-1.785-.881-2.062-.982-.276-.101-.477-.15-.678.15-.2.301-.777.982-.953 1.183-.175.201-.351.226-.652.075-1.792-.898-2.956-1.595-4.136-3.623-.313-.537.313-.499.896-1.667.099-.201.05-.376-.025-.526-.075-.15-.678-1.631-.929-2.232-.243-.585-.49-.506-.678-.515-.175-.008-.376-.011-.577-.011s-.527.075-.803.376c-.276.301-1.053 1.029-1.053 2.509 0 1.48 1.078 2.911 1.229 3.112.151.201 2.122 3.241 5.141 4.545.718.31 1.279.495 1.716.634.721.229 1.377.197 1.896.12.578-.086 1.785-.729 2.036-1.431.251-.702.251-1.304.175-1.431-.075-.127-.276-.201-.577-.352z"/>
                </svg>
              </a>
            </div>
          </div>
        </header>

        <div id="noticia-imagem-container" class="hidden w-full mb-10 rounded-lg overflow-hidden shadow-md max-h-[480px]">
          <img 
            id="noticia-imagem"
            src="" 
            alt="" 
            class="w-full h-full object-cover"
          />
        </div>

        <article id="noticia-conteudo" class="space-y-6 text-justify text-base md:text-lg leading-relaxed font-sans font-normal text-gray-900">
        </article>
      </div>

    </main>

    <Footer />
  </div>
</Layout>

<script>
  import Papa from 'papaparse';

  const SHEET_NEWS_URL = "https://docs.google.com/spreadsheets/d/e/2PACX-1vSFBphLgXDo2hNxvcVQ2vcJyYLplmKVVdtWQxj_9vYrT96mOuATdk6ZZug5LaBlh1oq5ruyA6on0wZy/pub?gid=0&single=true&output=csv";

  interface Noticia {
    slug: string;
    titulo: string;
    subtitulo: string;
    data: string;
    hora: string;
    autora: string;
    instagram: string;
    categoria: string;
    imagem: string;
    conteudo: string;
  }

  function formatDriveUrl(url: string) {
    if (!url) return "/logo-nebulosa.png";
    const match = url.match(/\/d\/([a-zA-Z0-9_-]+)/);
    if (match && match[1]) {
      return `https://lh3.googleusercontent.com/d/${match[1]}`;
    }
    return url;
  }

  async function carregarNoticia() {
    const loadingState = document.getElementById('loading-state');
    const errorState = document.getElementById('error-state');
    const articleContent = document.getElementById('article-content');

    // Obtém o slug diretamente da URL (ex: /noticias/minha-noticia -> minha-noticia)
    const pathSegments = window.location.pathname.split('/').filter(Boolean);
    const currentSlug = pathSegments[pathSegments.length - 1];

    if (!currentSlug) {
      if (loadingState) loadingState.classList.add('hidden');
      if (errorState) errorState.classList.remove('hidden');
      return;
    }

    try {
      const response = await fetch(`${SHEET_NEWS_URL}&t=${Date.now()}`);
      const csvText = await response.text();

      const parsed = Papa.parse<Noticia>(csvText, {
        header: true,
        skipEmptyLines: true,
      });

      const noticia = parsed.data.find(
        n => n.slug && n.slug.trim().toLowerCase() === currentSlug.trim().toLowerCase()
      );

      if (!noticia) {
        if (loadingState) loadingState.classList.add('hidden');
        if (errorState) errorState.classList.remove('hidden');
        return;
      }

      // Atualiza o título da aba do navegador
      document.title = `Nebulosa | ${noticia.titulo || 'Notícia'}`;

      // Preenche os campos textuais
      const elTitulo = document.getElementById('noticia-titulo');
      if (elTitulo) elTitulo.textContent = noticia.titulo || '';

      const elSubtitulo = document.getElementById('noticia-subtitulo');
      if (elSubtitulo && noticia.subtitulo) {
        elSubtitulo.textContent = noticia.subtitulo;
        elSubtitulo.classList.remove('hidden');
      }

      const elAutora = document.getElementById('noticia-autora');
      if (elAutora) {
        let autoraText = `Por ${noticia.autora || 'Nebulosa'}`;
        if (noticia.instagram) autoraText += `, ${noticia.instagram}`;
        elAutora.textContent = autoraText;
      }

      const elDataHora = document.getElementById('noticia-data-hora');
      if (elDataHora) {
        let dataText = noticia.data || '';
        if (noticia.hora) dataText += ` às ${noticia.hora}`;
        elDataHora.textContent = dataText;
      }

      // Preenche a imagem principal
      if (noticia.imagem) {
        const elImgContainer = document.getElementById('noticia-imagem-container');
        const elImg = document.getElementById('noticia-imagem') as HTMLImageElement;
        if (elImgContainer && elImg) {
          elImg.src = formatDriveUrl(noticia.imagem);
          elImg.alt = noticia.titulo || '';
          elImg.onerror = () => { elImg.src = '/logo-nebulosa.png'; };
          elImgContainer.classList.remove('hidden');
        }
      }

      // Preenche o conteúdo formatado em parágrafos
      const elConteudo = document.getElementById('noticia-conteudo');
      if (elConteudo) {
        const paragrafos = noticia.conteudo ? noticia.conteudo.split('\n\n') : [];
        if (paragrafos.length > 0) {
          elConteudo.innerHTML = paragrafos.map(p => `<p>${p}</p>`).join('');
        } else {
          elConteudo.innerHTML = `<p>${noticia.conteudo || ''}</p>`;
        }
      }

      // Botão de compartilhamento
      const shareBtn = document.getElementById('share-btn');
      if (shareBtn) {
        shareBtn.onclick = () => {
          if (navigator.share) {
            navigator.share({ title: document.title, url: window.location.href });
          } else {
            navigator.clipboard.writeText(window.location.href);
            alert('Link copiado!');
          }
        };
      }

      // Link do WhatsApp
      const wspBtn = document.getElementById('wsp-btn') as HTMLAnchorElement;
      if (wspBtn) {
        wspBtn.href = `https://api.whatsapp.com/send?text=${encodeURIComponent(noticia.titulo + ' - ' + window.location.href)}`;
      }

      // Exibe o conteúdo e esconde o carregamento
      if (loadingState) loadingState.classList.add('hidden');
      if (articleContent) articleContent.classList.remove('hidden');

    } catch (error) {
      console.error("Erro ao carregar os detalhes da notícia:", error);
      if (loadingState) loadingState.classList.add('hidden');
      if (errorState) errorState.classList.remove('hidden');
    }
  }

  carregarNoticia();
</script>