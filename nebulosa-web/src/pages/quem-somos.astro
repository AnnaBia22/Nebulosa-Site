---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Papa from 'papaparse';

const SHEET_CSV_URL = "https://docs.google.com/spreadsheets/d/e/2PACX-1vTWpkTmqQbKMxgCCRSUCG9TZ15pCRIQSE4d_zuyuAkA28D2ORRICKTGZ95OFp86gfcbuClO6uCn5kFl/pub?gid=0&single=true&output=csv";

interface Voluntaria {
  nome: string;
  cargo: string;
  categoria: string;
  foto: string;
  bio: string;
}

function formatDriveUrl(url: string) {
  if (!url) return "/logo-nebulosa.png";
  const match = url.match(/\/d\/([a-zA-Z0-9_-]+)/);
  if (match && match[1]) {
    return `https://lh3.googleusercontent.com/d/${match[1]}`;
  }
  return url;
}

let voluntarias: Voluntaria[] = [];

try {
  const response = await fetch(SHEET_CSV_URL);
  const csvText = await response.text();

  const parsed = Papa.parse<Voluntaria>(csvText, {
    header: true,
    skipEmptyLines: true,
  });

  voluntarias = parsed.data.filter(v => v.nome && v.nome.trim() !== '');
} catch (error) {
  console.error("Erro ao carregar dados dos membros:", error);
}

// Verificação da lista e extração das categorias
const temVoluntarias = voluntarias.length > 0;
const categorias = temVoluntarias 
  ? [...new Set(voluntarias.map(v => v.categoria))] 
  : [];
---

<Layout title="Nebulosa | Quem Somos">
  <div class="min-h-screen flex flex-col">
    <Header />

    <main class="w-full max-w-6xl mx-auto px-6 py-10 text-[#2F0147] font-acme flex-1">
      
      <h1 class="font-magic text-5xl md:text-5xl text-center text-[#F3A446] mb-8 tracking-wide">
        Quem Somos
      </h1>

      <div class="space-y-6 text-justify text-lg leading-relaxed font-normal max-w-4xl mx-auto text-gray-800 mb-16 indent-8">
        <p>
          O projeto Nebulosa nasce em 2026, quando as criadoras notaram uma lacuna no universo das feiras científicas. Embora esses eventos representem oportunidades únicas para o desenvolvimento acadêmico, criativo e pessoal dos estudantes, muitas vezes esse universo é visto como distante ou restrito a um grupo específico de pessoas. Além disso, desafios como a falta de recursos e de orientação adequada durante o desenvolvimento de pesquisas podem dificultar a entrada e a permanência de novos participantes nesse meio. 
        </p>
        <p>
          Assim, o Nebulosa busca tornar as feiras de ciências mais acessíveis, promovendo a educação criativa que conversa com o indivíduo ao estimular a educação e conhecimento sobre feiras de ciências.  Por meio de aulas, sessões de orientação individual e material didático visamos construir uma grande comunidade colaborativa no espaço da pesquisa acadêmica em nível escolar.
        </p>
        <p>
          Além disso, o projeto busca divulgar as feiras de ciências como uma ferramenta de aprendizado que possibilita aos estudantes aprofundar seus interesses e desenvolver autonomia intelectual, utilizando a pesquisa como um meio para compreender e solucionar problemas reais. O formato digital é uma ferramenta que conversa com a proposta de alcançar estudantes em diversas realidades, ao redor do Brasil.
        </p>
        <p>
          Sonhamos com uma noite estrelada de jovens cientistas que encontrem, por meio do nosso projeto, o impulso necessário para iniciar sua trajetória na pesquisa. Esperamos que nossos alunos se desenvolvam e se tornem grandes estrelas, inspirando o surgimento de novas protoestrelas e contribuindo para a formação de uma vasta galáxia científica, repleta de conhecimento, inovação e descobertas.
        </p>
        <p>
          <em>Como um berçário onde novas estrelas se formam, o Nebulosa busca ser um espaço onde a curiosidade se transforma em pesquisa e o potencial se transforma em realização.</em>
        </p>
      </div>

      <!-- Condicional de Verificação da Tabela -->
      {
        !temVoluntarias ? (
          <div class="w-full max-w-3xl mx-auto p-8 rounded-2xl bg-[#EFE3E8] border border-[#2F0147]/20 text-center shadow-md mb-16">
            <p class="text-xl font-bold text-[#2F0147] mb-2">
              Nenhuma voluntária encontrada no momento.
            </p>
            <p class="text-sm text-gray-700">
              Estamos atualizando a lista da nossa equipe!
            </p>
          </div>
        ) : (
          categorias.map((cat) => {
            const membros = voluntarias.filter(v => v.categoria === cat);
            if (membros.length === 0) return null;

            return (
              <section class="mb-20 w-full">
                <h2 class="font-magic text-2xl md:text-3xl text-[#2F0147] mb-8 text-center md:text-left">
                  {cat}
                </h2>

                <div class="flex flex-wrap justify-center gap-8 md:gap-12 w-full">
                  {membros.map((membro) => (
                    <div class="flex flex-col items-center text-center w-full sm:w-[calc(50%-1.5rem)] lg:w-[calc(33.333%-2rem)] max-w-sm bg-[#FDF8F2] p-6 rounded-2xl border border-[#2F0147]/10 shadow-lg">
                      
                      <div 
                        class="vortex-avatar relative flex items-center justify-center mb-6 cursor-pointer select-none overflow-hidden"
                        style="width: 190px; height: 190px; border-radius: 50%;"
                      >
                        <div class="vortex-ring absolute inset-0" style="border-radius: 50%;"></div>
                        
                        <div class="avatar-photo absolute inset-1.5 overflow-hidden transition-all duration-700" style="border-radius: 50%;">
                          <img 
                            src={formatDriveUrl(membro.foto)} 
                            alt={membro.nome} 
                            class="w-full h-full object-cover" 
                            onerror="this.onerror=null; this.src='/logo-nebulosa.png';"
                          />
                        </div>

                        <div class="avatar-onyx-card absolute inset-1.5 bg-[#0B0A10] p-4 flex flex-col items-center justify-center text-center text-gray-200 transition-all duration-700 opacity-0 pointer-events-none" style="border-radius: 50%;">
                          <div class="onyx-scroll w-full max-h-full overflow-y-auto px-1 py-2 font-sans text-xs leading-relaxed">
                            {membro.bio ? (
                              <p>{membro.bio}</p>
                            ) : (
                              <p class="text-gray-400 italic">Integrante da equipe {membro.categoria}.</p>
                            )}
                          </div>
                        </div>

                      </div>

                      <h3 class="text-xl font-bold text-[#2F0147]">
                        {membro.nome}
                      </h3>
                      <p class="text-base text-[#610F7F] font-semibold mt-0.5">
                        {membro.cargo}
                      </p>

                    </div>
                  ))}
                </div>
              </section>
            );
          })
        )
      }

    </main>

    <Footer />
  </div>
</Layout>

<style>
  @keyframes spin-vortex {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  .vortex-ring {
    background: conic-gradient(
      from 0deg,
      #040264 0%,
      #610F7F 25%,
      #00d2ff 50%,
      #2F0147 75%,
      #040264 100%
    );
    filter: blur(8px);
    opacity: 0.2;
    transition: opacity 0.5s ease, filter 0.5s ease;
  }

  .vortex-avatar {
    box-shadow: 0 0 20px rgba(97, 15, 127, 0.3);
    transition: box-shadow 0.5s ease, transform 0.3s ease;
    border: 2px solid rgba(155, 81, 224, 0.3);
  }

  .vortex-avatar:hover .vortex-ring,
  .vortex-avatar.active .vortex-ring {
    opacity: 1;
    filter: blur(10px);
    animation: spin-vortex 2.5s linear infinite;
  }

  .vortex-avatar:hover .avatar-photo,
  .vortex-avatar.active .avatar-photo {
    opacity: 0;
    transform: scale(0.2) rotate(180deg);
    filter: blur(6px);
  }

  .vortex-avatar:hover .avatar-onyx-card,
  .vortex-avatar.active .avatar-onyx-card {
    opacity: 1;
    pointer-events: auto;
    transform: scale(1) rotate(0deg);
  }

  .vortex-avatar:hover,
  .vortex-avatar.active {
    box-shadow: 0 0 30px rgba(0, 210, 255, 0.6);
    border-color: #00d2ff;
  }

  .onyx-scroll::-webkit-scrollbar {
    width: 3px;
  }

  .onyx-scroll::-webkit-scrollbar-track {
    background: rgba(255, 255, 255, 0.05);
    border-radius: 10px;
  }

  .onyx-scroll::-webkit-scrollbar-thumb {
    background: #610F7F;
    border-radius: 10px;
  }

  .onyx-scroll::-webkit-scrollbar-thumb:hover {
    background: #00d2ff;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const avatars = document.querySelectorAll('.vortex-avatar');
    avatars.forEach(avatar => {
      avatar.addEventListener('click', () => {
        avatar.classList.toggle('active');
      });
    });
  });
</script>